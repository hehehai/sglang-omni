// Set these values in Signing.local.xcconfig or pass explicit build settings.
VOXT_OMNI_APP_GROUP_ID =
VOXT_OMNI_XPC_SERVICE_ID =
VOXT_OMNI_HOST_BUNDLE_IDENTIFIER =
VOXT_OMNI_TEAM_IDENTIFIER =
VOXT_OMNI_NATIVE_RUNTIME_DIR =

#include "Signing.shared.xcconfig"

DEVELOPMENT_TEAM = $(VOXT_OMNI_TEAM_IDENTIFIER)
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
MACOSX_DEPLOYMENT_TARGET = 26.2
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG VOXT_OMNI_XPC_VALIDATION
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
ENABLE_DEBUG_DYLIB = NO
