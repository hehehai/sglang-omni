#include "OmniXPC.shared.xcconfig"

CODE_SIGN_ENTITLEMENTS = OmniInference/OmniInference.entitlements
PRODUCT_BUNDLE_IDENTIFIER = $(VOXT_OMNI_XPC_SERVICE_ID)
PRODUCT_NAME = OmniInference
PRODUCT_MODULE_NAME = OmniInference
REGISTER_APP_GROUPS = YES
INFOPLIST_FILE = OmniInference/Info.plist
GENERATE_INFOPLIST_FILE = NO
SWIFT_OBJC_BRIDGING_HEADER = OmniInference/OmniInference-Bridging-Header.h
HEADER_SEARCH_PATHS = $(inherited) "$(PROJECT_DIR)/../sglang_omni_mlx/native/include"
LIBRARY_SEARCH_PATHS = $(inherited) "$(VOXT_OMNI_NATIVE_RUNTIME_DIR)/bin"
OTHER_LDFLAGS = $(inherited) -lOmniCore
LD_RUNPATH_SEARCH_PATHS = @executable_path/../Frameworks
SWIFT_VERSION = 5.0
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SKIP_INSTALL = YES
